# Public client keys (they ship in the browser bundle; protect data with RLS).
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only admin key. Never prefix this with NEXT_PUBLIC_.
# Used by /api/public/[slug]/pdf to serve shared books without exposing storage.
INSFORGE_URL=
INSFORGE_API_KEY=
